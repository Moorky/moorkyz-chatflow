{
  "name": "moorkyz-chatflow",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.18.0"
  },
  "scripts": {
    "dev": "node scripts/assets.mjs && vite build --watch --mode development",
    "preview": "vite preview --host 127.0.0.1",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "test:real": "playwright test --config playwright.real.config.ts",
    "test:all": "npm run typecheck && npm run lint && npm run format:check && npm run test:coverage && npm run build && npm run test:e2e",
    "build": "node scripts/assets.mjs && vite build && node scripts/package.mjs",
    "verify": "npm run typecheck && npm run lint && npm run format:check && npm test && npm run build"
  },
  "dependencies": {
    "fflate": "0.8.3"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.64.1",
    "@types/node": "26.6.6",
    "@vitest/coverage-v8": "5.0.5",
    "eslint": "10.13.0",
    "fake-indexeddb": "6.2.6",
    "prettier": "3.9.10",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.1",
    "vite": "8.3.5",
    "vitest": "5.0.5"
  }
}
